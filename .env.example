# Optional: a provider supporting Chat Completions and function tool calls.
# The server reads this file as .env; keys never enter the browser or exports.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Optional live web search; without it, import source notes and URLs manually.
TAVILY_API_KEY=
AGENT_MAX_ROUNDS=6
AGENT_SEARCH_BUDGET=3
